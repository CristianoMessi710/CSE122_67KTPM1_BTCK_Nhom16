+export const initials = (name = '') => {
+    const words = String(name ?? '')
+        .trim()
+        .split(/\s+/)
+        .filter(Boolean);
+    if (!words.length) return '';
+    const first = Array.from(words[0])[0];
+    const last = words.length > 1 ? Array.from(words.at(-1))[0] : '';
+    return (first + last).toUpperCase();
+};
