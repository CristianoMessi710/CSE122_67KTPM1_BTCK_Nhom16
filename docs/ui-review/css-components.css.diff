+
 .search svg {
     position: absolute;
     left: 12px;
-    top: 14px;
+    top: 50%;
+    transform: translateY(-50%);
+    color: var(--muted);
     pointer-events: none;
 }
+
+.filters,
+.toolbar {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 12px;
+    margin-bottom: 20px;
+}
+
+.filters > .search,
+.toolbar > .search {
+    flex: 1 1 240px;
+    min-width: min(100%, 240px);
+}
+
+.filters select,
+.toolbar select {
+    width: auto;
+    min-width: 160px;
+    max-width: 100%;
+    flex: 0 1 auto;
+}
+
+.filters > input,
+.toolbar > input,
+.filters > .field,
+.toolbar > .field {
+    width: auto;
+    flex: 1 1 160px;
+    min-width: 0;
+    margin-bottom: 0;
+}
+
+.filters > .btn,
+.toolbar > .btn {
+    flex: 0 0 auto;
+    white-space: normal;
+}
+
+.room-card .actions {
+    display: flex;
+    flex: 0 1 auto;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: flex-end;
+    gap: 8px;
+    margin-left: auto;
+}
+
+.room-card .actions .btn {
+    min-height: 44px;
+    margin: 0;
+}
+
+.badge {
+    align-self: flex-start;
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    padding: 4px 8px;
+    border: 0;
+    border-radius: 8px;
+    font-size: 12px;
+    font-weight: 600;
+    line-height: 1.5;
+    white-space: nowrap;
+    background: var(--primary-light);
+    color: var(--primary-ink);
+}
+
+.status-badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    padding: 4px 8px;
+    border: 0;
+    border-radius: 8px;
+    font-size: 12px;
+    font-weight: 600;
+    line-height: 1.5;
+    white-space: nowrap;
+    background: var(--primary-light);
+    color: var(--primary-ink);
+}
+
+.badge.green,
+.badge.success,
+.badge.approved,
+.status-badge.approved {
+    background: var(--success-soft);
+    color: var(--success-ink);
+}
+
+.badge.yellow,
+.badge.warning,
+.badge.pending,
+.status-badge.pending {
+    background: var(--warning-soft);
+    color: var(--warning-ink);
+}
+
+.badge.red,
+.badge.error,
+.badge.rejected,
+.status-badge.rejected {
+    background: var(--error-soft);
+    color: var(--error-ink);
+}
+
+.badge.blue,
+.badge.info,
+.badge.completed,
+.status-badge.completed {
+    background: var(--info-soft);
+    color: var(--info-ink);
+}
+
+.badge.purple,
+.badge.ai {
+    background: var(--primary-light);
+    color: var(--primary-ink);
+}
+
+.badge.neutral {
+    background: var(--bg);
+    color: var(--text);
+}
+
+.notice.warning > .icon-svg {
+    color: var(--warning);
+}
+
+.notice.error > .icon-svg {
+    color: var(--error);
+}
+
+.notice :where(p, strong) {
+    color: inherit;
+}
+
+.progress {
+    background: var(--bg);
+    border-radius: 6px;
+    overflow: hidden;
+    height: 6px;
+    margin: 8px 0;
+}
+
+.bar {
+    background: var(--bg);
+    border-radius: 6px;
+    overflow: hidden;
+    height: 10px;
+}
+
+.progress span,
+.bar span {
+    display: block;
+    height: 100%;
+    border-radius: inherit;
+    background: var(--primary);
+}
+
+.progress.published,
+.bar.published {
+    --primary: var(--success);
+}
+
+.progress.pending,
+.bar.pending {
+    --primary: var(--warning);
+}
+
+.progress.rejected,
+.bar.rejected {
+    --primary: var(--error);
+}
+
+.progress.completed,
+.bar.completed {
+    --primary: var(--info);
+}
+
+/* The existing O1 renderer has a fixed published/pending/rejected/completed
+   order and no state class. Scope this compatibility mapping to that chart.
+   It also supplies the --primary consumed by its existing inline style. */
+
+body[data-screen='O1'] .split > div:first-child > .panel:first-child .bar-row:nth-child(1) {
+    --primary: var(--success);
+}
+
+body[data-screen='O1'] .split > div:first-child > .panel:first-child .bar-row:nth-child(2) {
+    --primary: var(--warning);
+}
+
+body[data-screen='O1'] .split > div:first-child > .panel:first-child .bar-row:nth-child(3) {
+    --primary: var(--error);
+}
+
+body[data-screen='O1'] .split > div:first-child > .panel:first-child .bar-row:nth-child(4) {
+    --primary: var(--info);
+}
+
+.session-card .meta > span,
+.session-meta > span,
+.feature-meta > span {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+}
+
+/* Catalog search is wrapped in its label, unlike the shared icon search. */
+
+.toolbar > .field:has(> #q) {
+    flex: 1 1 240px;
+    min-width: min(100%, 240px);
+}
+
+textarea {
+    font: inherit;
+    touch-action: manipulation;
+    overflow-wrap: anywhere;
+    resize: vertical;
+    min-height: 100px;
+}
